{
  "name": "healthcare-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the healthcare application",
  "scripts": {
    "setup": "node scripts/setup.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "demo": "node scripts/demo.js",
    "test:integration": "node scripts/test-integration.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed:doctors": "node --env-file-if-exists=.env scripts/seed-doctors.js",
    "test:mongo": "node --env-file-if-exists=.env scripts/test-appointments-mongo.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
