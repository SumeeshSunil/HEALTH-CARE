{
  "name": "healthcare-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the healthcare application",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed:doctors": "node --env-file-if-exists=.env scripts/seed-doctors.js",
    "test:mongo": "node --env-file-if-exists=.env scripts/test-appointments-mongo.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^9.11.2",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^8.2.1"
  }
}
